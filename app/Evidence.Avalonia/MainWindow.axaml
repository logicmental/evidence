<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Evidence"
        xmlns:md="using:Markdown.Avalonia"
        x:Class="Evidence.MainWindow"
        Title="evidence"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        Background="#111716">
    <Grid RowDefinitions="68,42,*">
        <Border Grid.Row="0" Background="#171F1D" BorderBrush="#2A3632" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="260,*,Auto" Margin="22,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Background="#315B4D">
                        <TextBlock Text="e" FontSize="22" FontWeight="Bold" Foreground="#D5F1E5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="evidence" FontSize="16" FontWeight="SemiBold" Foreground="#E5ECE9" />
                        <TextBlock x:Name="VaultLabel" Text="Personal vault" FontSize="11" Foreground="#87958F" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="NewNoteButton" Classes="primary" Content="New note" />
                    <Button x:Name="NewFolderButton" Content="New category" />
                    <Button x:Name="OpenNoteButton" Content="Open note" />
                    <Button x:Name="SaveButton" Content="Save" />
                    <Button x:Name="OpenFolderButton" Content="Open folder" />
                    <Button x:Name="TrashButton" Content="Trash" />
                </StackPanel>
                <ComboBox x:Name="LanguageSelector" Grid.Column="2" Width="118" VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Русский" Tag="ru" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#141B19" BorderBrush="#27312E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0" Spacing="7">
                <Button x:Name="AttachButton" Content="Attach file" />
                <Button x:Name="TemplatesButton" Content="Templates" />
                <Button x:Name="EncryptButton" Content="Encrypt note" />
                <Button x:Name="ProtectFolderButton" Content="Protect folder" />
                <Button x:Name="LinkButton" Content="Link note" />
                <Button x:Name="GraphButton" Content="Graph" />
                <Button x:Name="ExportButton" Content="Export" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="280,*">
            <Border Grid.Column="0" Background="#141B19" BorderBrush="#27312E" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,110,Auto" Margin="16,20,14,14">
                    <TextBlock x:Name="SidebarEyebrow" Text="YOUR NOTES" Classes="eyebrow" Margin="4,0,0,12" />
                    <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search notes" Margin="0,0,0,16" />
                    <ComboBox x:Name="FolderFilter" Grid.Row="2" PlaceholderText="All folders" Margin="0,0,0,14" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="3,0,2,7">
                        <TextBlock x:Name="NotesHeading" Text="Notes" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#B8C5C0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NoteCount" Grid.Column="1" Text="0" FontSize="11"
                                   Foreground="#7F8F88" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="NotesList" Grid.Row="4" SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:NoteItem">
                                <StackPanel Spacing="3" Margin="4,3">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                               Foreground="#D8E2DD" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RelativePath}" FontSize="10" Foreground="#788780"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TagsDisplay}" FontSize="10" Foreground="#78A996"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="BacklinksHeading" Grid.Row="5" Text="BACKLINKS" Classes="eyebrow"
                               Margin="4,10,0,5" />
                    <ListBox x:Name="BacklinksList" Grid.Row="6" />
                    <StackPanel Grid.Row="7" Spacing="8" Margin="4,14,4,0">
                        <Border Height="1" Background="#27312E" />
                        <TextBlock x:Name="VaultPathLabel" Text="" FontSize="10" Foreground="#718079"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="Vault path" />
                        <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="11" Foreground="#91A39A" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="28,22,28,14">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="2,0,2,18">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock x:Name="NoteTitle" Text="Select a note" FontSize="25" FontWeight="SemiBold"
                                   Foreground="#E5ECE9" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NoteSubtitle" Text="Markdown note" FontSize="11" Foreground="#819089" />
                    </StackPanel>
                    <Button x:Name="RenameButton" Grid.Column="1" Content="Rename" VerticalAlignment="Center"
                            Margin="10,0,0,0" />
                    <Button x:Name="DeleteButton" Grid.Column="2" Classes="danger" Content="Move to trash"
                            VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock x:Name="DirtyIndicator" Grid.Column="3" Text="Unsaved" Foreground="#D8A77A"
                               FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" IsVisible="False" />
                </Grid>

                <TextBox x:Name="TagsInput" Grid.Row="1" PlaceholderText="Tags, separated by commas"
                         Margin="2,0,2,14" />

                <Grid Grid.Row="2" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="1">
                    <Border Grid.Column="0" Classes="panel" CornerRadius="10,0,0,10">
                        <Grid RowDefinitions="38,38,*">
                            <Border Grid.Row="0" Background="#171F1D" BorderBrush="#293632" BorderThickness="0,0,0,1"
                                    CornerRadius="10,0,0,0">
                                <TextBlock x:Name="EditorHeading" Text="EDITOR" Classes="eyebrow" VerticalAlignment="Center" Margin="16,0" />
                            </Border>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3" Margin="8,3">
                                <Button x:Name="BoldButton" Content="B" ToolTip.Tip="Bold" Padding="8,4" />
                                <Button x:Name="ItalicButton" Content="I" ToolTip.Tip="Italic" Padding="8,4" />
                                <Button x:Name="CodeButton" Content="Code" ToolTip.Tip="Inline code" Padding="8,4" />
                                <Button x:Name="LinkFormatButton" Content="Link" ToolTip.Tip="Markdown link" Padding="8,4" />
                                <Button x:Name="Heading1Button" Content="H1" ToolTip.Tip="Heading 1" Padding="8,4" />
                                <Button x:Name="Heading2Button" Content="H2" ToolTip.Tip="Heading 2" Padding="8,4" />
                                <Button x:Name="ListButton" Content="List" ToolTip.Tip="List" Padding="8,4" />
                                <Button x:Name="QuoteButton" Content="Quote" ToolTip.Tip="Quote" Padding="8,4" />
                                <Button x:Name="UndoButton" Content="Undo" ToolTip.Tip="Undo" Padding="8,4" />
                                <Button x:Name="RedoButton" Content="Redo" ToolTip.Tip="Redo" Padding="8,4" />
                            </StackPanel>
                            <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="monospace" FontSize="14"
                                     PlaceholderText="Start writing in Markdown..."
                                     BorderThickness="0" CornerRadius="0" Padding="18"
                                     />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Classes="panel" CornerRadius="0,10,10,0">
                        <Grid RowDefinitions="38,*">
                            <Border Grid.Row="0" Background="#171F1D" BorderBrush="#293632" BorderThickness="0,0,0,1"
                                    CornerRadius="0,10,0,0">
                                <TextBlock x:Name="PreviewHeading" Text="PREVIEW" Classes="eyebrow" VerticalAlignment="Center" Margin="16,0" />
                            </Border>
                            <md:MarkdownScrollViewer x:Name="PreviewText" Grid.Row="1" Padding="20" />
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="FooterStatus" Grid.Row="3" Text="Markdown · UTF-8" FontSize="10"
                           Foreground="#687770" Margin="3,9,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
