<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Evidence.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="#111716" />
            <Setter Property="Foreground" Value="#E5ECE9" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#202A27" />
            <Setter Property="Foreground" Value="#E5ECE9" />
            <Setter Property="BorderBrush" Value="#35423D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#2B3834" />
            <Setter Property="BorderBrush" Value="#4C645B" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#376A57" />
            <Setter Property="Foreground" Value="#F0FAF5" />
            <Setter Property="BorderBrush" Value="#4C856E" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#457D67" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#2D201E" />
            <Setter Property="Foreground" Value="#E6A394" />
            <Setter Property="BorderBrush" Value="#50332D" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#432923" />
            <Setter Property="BorderBrush" Value="#70453A" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#181F1E" />
            <Setter Property="BorderBrush" Value="#2A3632" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#84938D" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#171F1D" />
            <Setter Property="Foreground" Value="#E5ECE9" />
            <Setter Property="BorderBrush" Value="#35423D" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#73B7A1" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#263D35" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
    </Application.Styles>
</Application>